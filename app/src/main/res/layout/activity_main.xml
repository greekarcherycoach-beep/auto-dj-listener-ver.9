<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_logo"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Dj Ape1 – Private Audio Broadcast"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />
        </FrameLayout>

        <!-- Εργαλεία: θέμα, σάρωση QR, φωτεινό/σκοτεινό, info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMood"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Theme and style"
                android:padding="11dp"
                android:src="@drawable/ic_palette" />

            <ImageView
                android:id="@+id/btnScan"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Scan invitation QR"
                android:padding="11dp"
                android:src="@drawable/ic_qr" />

            <ImageView
                android:id="@+id/theme"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Light or dark theme"
                android:padding="11dp"
                android:src="@drawable/ic_sunmoon" />

            <ImageView
                android:id="@+id/btnInfo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Info"
                android:padding="11dp"
                android:src="@drawable/ic_info" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/moodScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/moodRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Ready"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/coverBox"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_field"
                android:clipToOutline="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Cover art"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="…"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawablePadding="6dp"
                    android:textSize="13.5sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:drawablePadding="5dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="9dp"
                        android:paddingTop="3dp"
                        android:paddingRight="9dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:drawablePadding="5dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="9dp"
                        android:paddingTop="3dp"
                        android:paddingRight="9dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:id="@+id/air"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_air"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="9dp"
                        android:paddingTop="3dp"
                        android:paddingRight="9dp"
                        android:paddingBottom="3dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/airText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ON AIR"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.djape1.player.EqView
                            android:id="@+id/eq"
                            android:layout_width="16dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/play"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:gravity="center"
            android:text="Listen now"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/volIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_volume" />

            <SeekBar
                android:id="@+id/volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Volume"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progressDrawable="@drawable/seek_track"
                android:thumb="@drawable/seek_thumb" />
        </LinearLayout>

        <!-- Τρέχουσα ζώνη με περιγραφή -->
        <LinearLayout
            android:id="@+id/zoneBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_field"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/zoneIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_card"
                    android:importantForAccessibility="no"
                    android:padding="7dp"
                    android:src="@drawable/ic_music" />

                <TextView
                    android:id="@+id/zoneName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/zoneDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/weeklyBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Weekly program"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/invBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:drawablePadding="10dp"
                android:focusable="true"
                android:gravity="center"
                android:text="Scan station QR"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="or paste the station address"
                android:textSize="12.5sp" />

            <EditText
                android:id="@+id/invInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="url"
                android:background="@drawable/bg_field"
                android:hint="https://…/l/…"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/saveInv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Save invitation"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
